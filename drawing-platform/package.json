{
  "name": "system-canvas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "generate:kv": "node --import tsx scripts/generate-kv-template.mjs",
    "generate:remaining": "node --import tsx scripts/generate-remaining-templates.mjs",
    "generate:designs": "npm run generate:kv && npm run generate:remaining",
    "verify:visuals": "node --experimental-websocket --import tsx scripts/verify-layout-visuals.mjs",
    "dev": "concurrently --kill-others-on-fail --names api,web --prefix-colors magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "lint": "eslint src server shared tests scripts vite.config.ts",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "10.1.3",
    "fastify": "5.12.1",
    "lucide-react": "0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "20.17.30",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "9.2.4",
    "eslint": "9.36.0",
    "sharp": "0.34.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.44.1",
    "vite": "6.4.3",
    "vitest": "3.2.7"
  }
}
